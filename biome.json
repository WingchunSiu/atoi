{
  "files": {
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!**/dist",
      "!**/node_modules",
      "!.atoi",
      "!.cache"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
