# Use Node 24+. Never commit .env or real credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<hackathon-cluster>/?retryWrites=true&w=majority
MONGODB_DATABASE=atoi
ADMIN_TOKEN=<random-secret-at-least-32-characters>
AGENT_TOKEN_SECRET=<different-random-secret-at-least-32-characters>
BACKEND_PUBLIC_URL=https://<authenticated-api-tunnel-host>
API_HOST=127.0.0.1
API_PORT=3000
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=atoi-agents
MODAL_APP_NAME=atoi-agents
MODAL_IMAGE_TAG=node:24-bookworm-slim
# Modal SDK can also read the active ~/.modal.toml profile.
# MODAL_TOKEN_ID=<token-id>
# MODAL_TOKEN_SECRET=<token-secret>
# Create a named Modal Secret containing ATOI_MODEL_API_KEY.
# MODAL_MODEL_SECRET=<model-secret-name>
# Or inject a key directly through the trusted adapter:
# ATOI_MODEL_API_KEY=<model-api-key>
# Optional named Secret containing GITHUB_TOKEN, scoped to your demo repository.
# MODAL_GIT_SECRET=<git-secret-name>
# Use a provider/model pair supported by the pinned Pi SDK catalog.
PI_PROVIDER=openai
PI_MODEL=gpt-4.1
TURN_TIMEOUT_MS=180000
TURN_MODEL_REQUESTS=12
TURN_TOOL_CALLS=40
