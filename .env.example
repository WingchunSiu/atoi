# Use a MongoDB replica set (including Atlas); standalone servers cannot transact.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=atoi_dev
# Replace with a random secret of at least 32 characters.
ADMIN_TOKEN=replace-with-a-random-admin-token-at-least-32-characters
HOST=127.0.0.1
PORT=3000
# Optional for the HTTP demo when the API is not on localhost:3000.
API_URL=http://127.0.0.1:3000
