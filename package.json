{
  "name": "atoi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "test:unit": "node --import tsx --test test/validation.test.ts",
    "test:integration": "node --import tsx --test test/coordination.test.ts",
    "db:local": "node --import tsx scripts/local-mongo.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.5",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "mongodb-memory-server-core": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
